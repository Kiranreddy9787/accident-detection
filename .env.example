# Copy this file to a new file named `.env` and fill in YOUR OWN credentials.
# The `.env` file is git-ignored and must NEVER be committed (it contains secrets).
# Values already set in the shell (e.g. run_flask.bat) take priority over .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# Replace with YOUR MySQL root (or dedicated app user) password.
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=accident_detection

# A long random string used to sign Flask session cookies. Keep it secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret